.TH MYSTRCPY 3 "September 2026" "libmyutils 0.4.1" "libmyutils Manual"
.SH NAME
mystrcpy \- copy a string
.SH SYNOPSIS
#include "mystrfunctions.h"
.PP
.B int mystrcpy(char *dest, const char *src);
.SH DESCRIPTION
.B mystrcpy()
copies the string
.I src
into
.IR dest ,
including the null character at the end.
.I dest
must be large enough to hold the copy.
.SH RETURN VALUE
The number of characters copied.
